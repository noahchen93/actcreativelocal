GOOGLE_SITE_VERIFICATION=

# Google Search Console API
GSC_SITE_URL=sc-domain:actcreative.net
GSC_SERVICE_ACCOUNT_KEY_FILE=
GSC_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SPREADSHEET_ID=

# Local ACT Event AI
LOCAL_AI_HOST=127.0.0.1
LOCAL_AI_PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=act-event-assistant
OLLAMA_EMBEDDING_MODEL=act-rag-embedding

# Set only when the local AI gateway is securely available to a deployed site.
VITE_ENABLE_EVENT_AI=false
