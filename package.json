            "ai:prod:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-production-ai.ps1",
            "ai:prod:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-production-ai-supervisor.ps1",
            "ai:prod:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-production-ai.ps1",
            "ai:prod:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-production-tunnel.ps1",
