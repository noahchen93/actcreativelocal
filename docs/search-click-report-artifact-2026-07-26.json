    {
      "id": "gsc_performance",
      "label": "Google Search Console — 搜索结果",
      "href": "https://search.google.com/search-console/performance/search-analytics?resource_id=sc-domain%3Aactcreative.net",
      "query": {
        "engine": "Google Search Console",
        "language": "sql",
        "sql": "WITH reviewed_rows(record_type, label, clicks_current, clicks_prior, impressions_current, impressions_prior, ctr_current, ctr_prior, position_current, position_prior) AS (VALUES ('summary','All search results',85,29,7593,3194,0.011,0.009,27.7,48.2),('page','Food truck rental',12,3,388,77,0.031,0.039,16.5,24.8),('page','Homepage',12,17,70,47,0.171,0.362,4.7,4.2),('page','Event fabrication HK',9,2,105,35,0.086,0.057,22.6,18.5),('page','Booth design/build',8,0,2004,1236,0.004,0,46.8,70.7),('page','Custom props',7,3,435,58,0.016,0.052,30.6,15.7),('page','Event fabrication SG',5,1,862,747,0.006,0.001,14.1,22.4),('page','FRP sculpture',5,0,63,29,0.079,0,7.8,20.9),('page','Venue finder',3,1,245,24,0.012,0.042,7.8,10.0),('page','National Museum',3,0,229,0,0.013,0,7.9,NULL),('page','Marina Bay Sands',2,0,381,40,0.005,0,11.8,11.2)) SELECT * FROM reviewed_rows;",
        "description": "从 actcreative.net 的 Search results 报告中复核最近 28 天与前 28 天的总览、查询、页面、国家和设备数据。",
        "executed_at": "2026-07-26T15:00:00+08:00",
        "tables_used": [
          "Search results performance"
        ],
        "filters": [
          "Property: sc-domain:actcreative.net",
          "Search type: Web",
          "Current period: 2026-06-26 to 2026-07-23",
          "Comparison period: 2026-05-29 to 2026-06-25"
        ],
        "metric_definitions": [
          "Clicks：用户从 Google 搜索结果点击进入网站的次数。",
          "Impressions：网站链接在 Google 搜索结果中展示的次数。",
          "CTR：Clicks / Impressions。",
          "Average position：网站最高结果在各次展示中的平均排名；数值越低越好。"
        ]
      }
    },
    {
      "id": "vercel_analytics",
      "label": "Vercel Web Analytics — actcreativelocal",
      "href": "https://vercel.com/noah-chens-projects-c58c1ebe/actcreativelocal/analytics",
      "query": {
        "engine": "Vercel Web Analytics",
        "language": "sql",
        "sql": "WITH reviewed_rows(record_type, label, visitors, pageviews, bounce_rate) AS (VALUES ('summary','All traffic',108,155,0.80),('page','Homepage',74,101,NULL),('page','Venue finder',6,8,NULL),('page','National Museum',5,5,NULL),('page','Event fabrication SG',4,4,NULL),('page','ArtScience Museum',2,2,NULL),('page','Esplanade',2,2,NULL)) SELECT * FROM reviewed_rows;",
        "description": "从 actcreativelocal 生产项目的 Web Analytics 报告中复核最近 30 天的访客、浏览量、跳出率、页面、来源、国家和设备数据。",
        "executed_at": "2026-07-26T15:00:00+08:00",
        "tables_used": [
          "Web Analytics production environment"
        ],
        "filters": [
          "Project: actcreativelocal",
          "Domains include actcreative.net and www.actcreative.net",
          "Environment: Production",
          "Current period: 2026-06-26 15:00 to 2026-07-26 15:59 Asia/Singapore",
          "Comparison: previous 30 days as displayed by Vercel"
        ],
        "metric_definitions": [
          "Visitors：Vercel 去重后的访客数。",
          "Page Views：页面被查看的总次数。",
          "Bounce Rate：仅发生一次页面浏览且未继续浏览的访问占比；数值越低通常越好。",
          "上期 Visitors、Page Views 与 Bounce Rate 为根据界面展示的整数/百分比变化反推的近似值。"
        ]
      }
    }
